def get_morning_ohlc(security_list, context):
    """获取当日截止11点的OHLC数据"""
    result = {}
    today = context.current_dt.date()
    
    for security in security_list:
        try:
            df = get_price(security,
                          end_date=context.current_dt,
                          count=100,
                          frequency='minute',
                          fields=['open', 'high', 'low', 'close'])
            
            if df is None or len(df) == 0:
                continue
            
            df = df[df.index.date == today]
            
            if len(df) < 10:
                continue
            
            result[security] = {
                'open': df['open'].iloc[0],
                'high': df['high'].max(),
                'low': df['low'].min(),
                'close': df['close'].iloc[-1]
            }
        except Exception as e:
            continue
    
    return result

def select_and_trade(context):
    """11点选股并直接交易"""
    today = context.current_dt.date()
    current_data = get_current_data()
    
    # 构建计算列表
    calc_pool = g.etf_pool + [g.bench_shanghai, g.bench_chuangye]
    
    # 获取当日上午OHLC数据
    morning_data = get_morning_ohlc(calc_pool, context)
    log.info(f'获取到 {len(morning_data)} 个标的的上午数据')
    
    # 计算所有ETF的综合得分
    scores = calc_all_scores(calc_pool, today, morning_data)
    
    if not scores:
        log.warn('无法计算ETF得分')
        return
    
    # 提取择时基准得分
    score_sh = scores.get(g.bench_shanghai, 0)
    score_cy = scores.get(g.bench_chuangye, 0)
    
    # 按得分排序
    tradable_scores = {etf: score for etf, score in scores.items() if etf in g.etf_pool}
    sorted_etfs = sorted(tradable_scores.items(), key=lambda x: x[1], reverse=True)
    
    if not sorted_etfs:
        log.warn('无法计算ETF得分')
        return
    
    best_etf, best_score = sorted_etfs[0]
    second_etf, second_score = sorted_etfs[1] if len(sorted_etfs) > 1 else (None, 0)
    
    log.info('=' * 60)
    log.info('【11点选股交易】%s' % today)
    log.info('ETF得分: %s' % {etf: round(score, 4) for etf, score in sorted_etfs})
    log.info('基准 - 上证: %.4f, 创业板: %.4f' % (score_sh, score_cy))
    
    # ========== 判断交易逻辑 ==========
    target_etf = None
    should_empty = False
    
    # 纳指例外规则
    nasdaq_score = scores.get(g.nasdaq_etf, 0)
    is_nasdaq_best = (best_etf == g.nasdaq_etf and nasdaq_score > 0)
    
    # 空仓判断
    shanghai_available = g.bench_shanghai in scores
    chuangye_available = g.bench_chuangye in scores
    
    if not shanghai_available or not chuangye_available:
        target_etf = best_etf
    elif is_nasdaq_best:
        log.info('纳指ETF得分最高，不受空仓限制')
        target_etf = best_etf
    elif score_sh > score_cy + g.empty_threshold:
        log.info('空仓信号：上证(%.4f) > 创业板(%.4f) + %.2f' % (score_sh, score_cy, g.empty_threshold))
        should_empty = True
    else:
        if g.is_empty_position:
            log.info('空仓结束，可以开仓')
        
        # 调仓判断
        if g.current_hold is None:
            target_etf = best_etf
            log.info('首次建仓: %s' % best_etf)
        elif g.current_hold not in scores:
            target_etf = best_etf
            log.info('当前持仓不在池中，切换: %s' % best_etf)
        elif best_etf != g.current_hold:
            current_score = scores.get(g.current_hold, 0)
            threshold_score = current_score + g.switch_threshold
            
            if current_score <= 0 or best_score > threshold_score:
                target_etf = best_etf
                log.info('调仓: %s(%.4f) -> %s(%.4f)' % (g.current_hold, current_score, best_etf, best_score))
            else:
                target_etf = g.current_hold
                log.info('未达阈值，保持: %s(%.4f)' % (g.current_hold, current_score))
        else:
            target_etf = g.current_hold
    
    # ========== 执行交易 ==========
    # 空仓处理
    if should_empty:
        if g.current_hold and g.current_hold in context.portfolio.positions:
            position = context.portfolio.positions[g.current_hold]
            if position.closeable_amount > 0:
                if current_data[g.current_hold].last_price > current_data[g.current_hold].low_limit:
                    order_target(g.current_hold, 0)
                    log.info('空仓卖出: %s' % g.current_hold)
                    g.current_hold = None
                else:
                    log.warn('%s 跌停无法卖出' % g.current_hold)
        g.is_empty_position = True
        action_type = "清仓空仓"
    
    # 正常交易
    elif target_etf:
        g.is_empty_position = False
        
        if target_etf != g.current_hold:
            # 需要调仓
            # 检查目标是否可买
            if current_data[target_etf].paused:
                log.warn('%s 停牌无法买入，保持当前持仓' % target_etf)
                action_type = "停牌保持"
            elif current_data[target_etf].last_price >= current_data[target_etf].high_limit:
                log.warn('%s 涨停无法买入，保持当前持仓' % target_etf)
                action_type = "涨停保持"
            else:
                # 先卖后买
                if g.current_hold and g.current_hold in context.portfolio.positions:
                    position = context.portfolio.positions[g.current_hold]
                    if position.closeable_amount > 0:
                        if current_data[g.current_hold].last_price > current_data[g.current_hold].low_limit:
                            order_target(g.current_hold, 0)
                            log.info('卖出: %s' % g.current_hold)
                        else:
                            log.warn('%s 跌停无法卖出，保持持仓' % g.current_hold)
                            action_type = "跌停保持"
                            target_etf = g.current_hold
                
                # 买入
                if target_etf != g.current_hold:
                    cash = context.portfolio.available_cash
                    order_value(target_etf, cash * 0.98)
                    log.info('买入: %s' % target_etf)
                    g.current_hold = target_etf
                    action_type = "换股调仓" if g.current_hold else "首次建仓"
        else:
            action_type = "保持持仓"
            log.info('保持持仓: %s' % g.current_hold)
    else:
        action_type = "无操作"
    
    # ========== 发送消息 ==========
    current_score = scores.get(g.current_hold, 0) if g.current_hold else 0
    target_score = scores.get(target_etf, 0) if target_etf else 0
    
    send_to_wx = (
        f"【11点交易】{today}\n"
        f"操作：{action_type}\n"
        f"持仓：{g.current_hold or '空仓'} ({current_score:.4f})\n"
        f"上证：{score_sh:.4f} | 创业板：{score_cy:.4f}\n"
        f"第一：{best_etf} ({best_score:.4f})"
    )
    if second_etf:
        send_to_wx += f"\n第二：{second_etf} ({second_score:.4f})"
    
    send_message(send_to_wx)
    log.info('=' * 60)

def calc_all_scores(etf_pool, today, morning_data):
    """计算所有ETF的综合得分"""
    max_window = max(g.bias_n, g.slope_n, g.efficiency_n)
    data_days = g.bias_n + max_window + 10
    
    price_df = get_price(etf_pool, end_date=today-timedelta(days=1), count=data_days, 
                         fields=['open', 'high', 'low', 'close'], panel=False)
    
    if len(price_df) == 0:
        return {}
    
    scores = {}
    factor_values = {'bias': {}, 'slope': {}, 'efficiency': {}}
    
    for etf in etf_pool:
        etf_data = price_df[price_df['code'] == etf].copy()
        
        if len(etf_data) == 0 or len(etf_data) < data_days - 5:
            continue
        
        # 追加当日上午数据
        if morning_data and etf in morning_data:
            am = morning_data[etf]
            today_row = pd.DataFrame({
                'code': [etf],
                'open': [am['open']],
                'high': [am['high']],
                'low': [am['low']],
                'close': [am['close']]
            })
            etf_data = pd.concat([etf_data, today_row], ignore_index=True)
        
        close_prices = pd.Series(etf_data['close'].values)
        
        bias_momentum = calc_bias_momentum(close_prices)
        slope_momentum = calc_slope_momentum(close_prices)
        efficiency_momentum = calc_efficiency_momentum(etf_data)
        
        if bias_momentum is not None and not np.isnan(bias_momentum):
            factor_values['bias'][etf] = bias_momentum
        if slope_momentum is not None and not np.isnan(slope_momentum):
            factor_values['slope'][etf] = slope_momentum
        if efficiency_momentum is not None and not np.isnan(efficiency_momentum):
            factor_values['efficiency'][etf] = efficiency_momentum
    
    z_bias = z_score_normalize(factor_values['bias'])
    z_slope = z_score_normalize(factor_values['slope'])
    z_efficiency = z_score_normalize(factor_values['efficiency'])
    
    for etf in etf_pool:
        if etf in z_bias and etf in z_slope and etf in z_efficiency:
            scores[etf] = (g.weight_bias * z_bias[etf] + 
                          g.weight_slope * z_slope[etf] + 
                          g.weight_efficiency * z_efficiency[etf])
    
    return scores

def calc_bias_momentum(close_prices):
    """乖离动量因子"""
    if close_prices.empty or len(close_prices) < g.bias_n + 25:
        return np.nan
    
    ma = close_prices.rolling(window=g.bias_n, min_periods=1).mean()
    bias = close_prices / ma
    
    momentum_day = 25
    bias_recent = bias.iloc[-momentum_day:]
    
    if len(bias_recent) < momentum_day:
        return np.nan
    
    base = bias_recent.iloc[0]
    if base == 0:
        return np.nan
    
    y = (bias_recent / base).values
    x = np.arange(momentum_day)
    
    slope, intercept, r_value, p_value, std_err = stats.linregress(x, y)
    return float(slope) * 10000

def calc_slope_momentum(close_prices):
    """斜率动量因子"""
    if len(close_prices) < g.slope_n:
        return np.nan
    
    recent_prices = close_prices.iloc[-g.slope_n:]
    base_price = recent_prices.iloc[0]
    if base_price <= 0:
        return np.nan
    
    normalized_prices = recent_prices / base_price
    y = normalized_prices.values
    x = np.arange(1, g.slope_n + 1)
    
    slope, intercept, r_value, p_value, std_err = stats.linregress(x, y)
    r_squared = r_value ** 2
    return 10000 * float(slope) * float(r_squared)

def calc_efficiency_momentum(df):
    """效率动量因子"""
    if len(df) < g.efficiency_n:
        return np.nan
    
    window = df.iloc[-g.efficiency_n:]
    pivot = (window['open'] + window['high'] + window['low'] + window['close']) / 4.0
    
    if isinstance(pivot, pd.DataFrame):
        pivot = pivot.iloc[:, 0]
    
    pivot = pivot.ffill()
    first_val = pivot.iloc[0]
    last_val = pivot.iloc[-1]
    
    if first_val <= 0 or last_val <= 0:
        return np.nan
    
    momentum = 100 * np.log(last_val / first_val)
    direction = abs(np.log(last_val) - np.log(first_val))
    volatility = np.log(pivot).diff().abs().sum()
    
    if volatility > 0:
        efficiency_ratio = direction / volatility
    else:
        return np.nan
    
    return momentum * efficiency_ratio

def z_score_normalize(factor_dict):
    """Z-Score标准化"""
    if not factor_dict or len(factor_dict) < 2:
        return factor_dict
    
    values = list(factor_dict.values())
    mean_val = np.mean(values)
    std_val = np.std(values)
    
    if std_val <= 0:
        return {k: 0 for k in factor_dict}
    
    return {k: (v - mean_val) / std_val for k, v in factor_dict.items()}